# Copié vers api/.env à la création du dev container (postCreateCommand).
# Identifiants de dev locaux : les mêmes que le service db de compose.yaml.
PORT=3000
DATABASE_URL=postgres://app:app@db:5432/app

# IA : mock (réponse fixe, par défaut) ou data (service FastAPI de l'équipe
# Data/IA, lancé sur l'hôte avec uvicorn api:app --host 0.0.0.0 --port 8000)
AI_PROVIDER=mock
# Lue seulement si AI_PROVIDER=data. host.docker.internal : la machine hôte,
# vue depuis le conteneur (extra_hosts dans compose.yaml)
DATA_AI_URL=http://host.docker.internal:8000
